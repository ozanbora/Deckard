<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Deckard.App.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Deckard overlay">
    <!-- Filled with an ItemCard in code; dragging it moves the window. -->
    <Border x:Name="Panel" Width="380" VerticalAlignment="Top" Background="#0E0D0C"
            PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" PointerPressed="OnDragStart" PointerMoved="OnDragMove" PointerReleased="OnDragEnd" PointerCaptureLost="OnDragEnd" />
</Window>
