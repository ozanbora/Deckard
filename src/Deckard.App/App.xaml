<?xml version="1.0" encoding="utf-8"?>
<!-- Dark only: the whole app takes the colors and typeface of Diablo IV's item tooltips (see ItemCard). -->
<Application
    x:Class="Deckard.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- PT Serif (SIL Open Font License, see Assets/Fonts), the font of Diablo IV's own tooltips. It ships one file per style, hence three keys. -->
            <FontFamily x:Key="CardFont">ms-appx:///Assets/Fonts/PT_Serif-Web-Regular.ttf#PT Serif</FontFamily>
            <FontFamily x:Key="CardFontBold">ms-appx:///Assets/Fonts/PT_Serif-Web-Bold.ttf#PT Serif</FontFamily>
            <FontFamily x:Key="CardFontItalic">ms-appx:///Assets/Fonts/PT_Serif-Web-Italic.ttf#PT Serif</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/PT_Serif-Web-Regular.ttf#PT Serif</FontFamily>
            <x:Double x:Key="ControlContentThemeFontSize">15</x:Double>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CardFont}" />
            </Style>
            <!-- Titles: bold small caps in the unique items' tan, like a tooltip's name line. -->
            <Style x:Key="DisplayTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CardFontBold}" />
                <Setter Property="CharacterSpacing" Value="80" />
                <Setter Property="Foreground" Value="{ThemeResource TitleBrush}" />
            </Style>

            <ResourceDictionary.ThemeDictionaries>
                <!-- The tooltip palette: near-black panel, warm gray text, light numbers, legendary orange as the accent. -->
                <ResourceDictionary x:Key="Dark">
                    <!-- Dark mode fills accent controls with Light2 and hovers with Light3. -->
                    <Color x:Key="SystemAccentColor">#BF642F</Color>
                    <Color x:Key="SystemAccentColorLight1">#C66C36</Color>
                    <Color x:Key="SystemAccentColorLight2">#A9542A</Color>
                    <Color x:Key="SystemAccentColorLight3">#D07A42</Color>
                    <Color x:Key="SystemAccentColorDark1">#A65527</Color>
                    <Color x:Key="SystemAccentColorDark2">#8A461F</Color>
                    <Color x:Key="SystemAccentColorDark3">#6E3818</Color>
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#F0ECE4" />
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#F0ECE4" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#F0ECE4" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#E0D8CC" />
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E6E1D8" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#B2ACA2" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#787064" />

                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0A0908" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#0E0D0C" />
                    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#34302C" />
                    <SolidColorBrush x:Key="TitleBrush" Color="#C7B377" />
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="#B2ACA2" />
                    <SolidColorBrush x:Key="StatusPillBrush" Color="#14120F" />

                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
